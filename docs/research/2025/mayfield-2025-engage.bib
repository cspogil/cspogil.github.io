@unpublished{mayfield-2025-engage,
  author        = {Mayfield, Chris and Campbell, Patricia and Hu, Helen H. and Kussmaul, Clif},
  title         = {Exploring the Impact of POGIL on Student Engagement},
  howpublished  = {National Conference to Advance POGIL Practice (NCAPP) (poster)},
  year          = {2026},
  url           = {},
  abstract      = {
    This poster presents data from 16 introductory computer science sections at two universities, 
    involving six instructors and hundreds of students.
    Using structured classroom observations and student surveys,
    we measure the engagement of the same students in different class periods taught by the same instructor.
    We observed each section six times during the semester, and the data spans three semesters in total.
    The results show significant differences in observed instructor and student behaviors based on the pedagogical approach. 
  }
}